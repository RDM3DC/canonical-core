# Video files (large binary files)
# Ignore all files and subdirectories in videos folder except README.md
# This allows tracking documentation while excluding large video content
videos/**
!videos/README.md

# Manim cache and temporary files
media/
__pycache__/
*.pyc

# Python virtual environment
venv/
env/
.venv/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
tmp/
